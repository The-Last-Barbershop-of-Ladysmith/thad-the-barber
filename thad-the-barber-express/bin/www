#!/usr/bin/env node

require('../lib/telemetry').startTelemetry(process.env);

var app = require('../app');
var debug = require('debug')('thad-the-barber-express:server');

var port = Number(process.env.PORT) || 3000;

app.listen(port, function(err) {
  if (err) {
    throw err;
  }
  debug('Listening at http://localhost:' + port);
});
