<!doctype html>
<html lang="en" class="app-dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title>Something went wrong</title>
  <link rel="stylesheet" href="/brand.css">
  <link rel="stylesheet" href="/stylesheets/error.css">
</head>
<body>
  <header class="site-header">
    <a href="/" class="home-link"><img src="/assets/logo.png" alt="Home" class="logo" width="830" height="366"></a>
  </header>
  <main class="panel">
    <p class="eyebrow">Error <%= status %></p>
    <h1>Something went wrong</h1>
    <p class="lead">Sorry, this page didn't load. Please try again in a moment.</p>
    <div class="actions">
      <a class="button" href="<%= retryUrl %>" data-testid="error-retry">Try again</a>
      <a class="text-link" href="/" data-testid="error-home">Back to home</a>
    </div>
    <p class="request-id">Request ID <code data-testid="error-request-id"><%= requestId %></code></p>
<% if (stack) { -%>
    <details class="details" open data-testid="error-details">
      <summary>Error details</summary>
      <pre><%= stack %></pre>
    </details>
<% } -%>
  </main>
</body>
</html>
