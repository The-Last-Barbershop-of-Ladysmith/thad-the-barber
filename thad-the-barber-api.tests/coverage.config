<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft code coverage settings (https://learn.microsoft.com/visualstudio/test/customizing-code-coverage-analysis).
     Test assemblies are already excluded by default; this drops source-generated code (e.g. the OpenAPI XML comment
     generator) so the report only measures code we wrote. -->
<Configuration>
  <CodeCoverage>
    <Sources>
      <Exclude>
        <Source>.*[\\/]obj[\\/].*</Source>
      </Exclude>
    </Sources>
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
