<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ThadTheBarber.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\thad-the-barber-api\thad-the-barber-api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- testconfig.json turns coverage on for every run. The settings path goes here instead, because testconfig.json
         resolves paths from wherever dotnet test was started. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --coverage-settings &quot;$(MSBuildProjectDirectory)/coverage.config&quot;</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
