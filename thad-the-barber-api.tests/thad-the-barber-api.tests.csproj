<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ThadTheBarber.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <ProjectReference Include="..\thad-the-barber-api\thad-the-barber-api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Collect coverage on every run. Paths are anchored to this project, because Microsoft.Testing.Platform resolves
         relative paths from wherever dotnet test was started. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory &quot;$(MSBuildProjectDirectory)/TestResults&quot; --coverage --coverage-output-format cobertura --coverage-output coverage.cobertura.xml --coverage-settings &quot;$(MSBuildProjectDirectory)/coverage.config&quot;</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
