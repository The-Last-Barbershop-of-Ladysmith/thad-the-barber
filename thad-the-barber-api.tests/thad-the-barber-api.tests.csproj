<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>ThadTheBarber.Api.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <None Include="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\thad-the-barber-api\thad-the-barber-api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Collect coverage on every run. Paths are anchored to this project, because Microsoft.Testing.Platform resolves
         relative paths from wherever dotnet test was started. -->
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --results-directory "$(MSBuildProjectDirectory)/TestResults" --coverage --coverage-output-format cobertura --coverage-output coverage.cobertura.xml --coverage-settings "$(MSBuildProjectDirectory)/coverage.config"</TestingPlatformCommandLineArguments>
  </PropertyGroup>

</Project>
